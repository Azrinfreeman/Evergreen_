--- !u!114 &1026078785
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1026078783}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ce927798c407524d9f3e6481e7604ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionlist:
  - question:
    - Mengapa kita menggunakan grafit atau arang aktif sebagai elektrod?
    QuestionOnAnswersBtn:
    - answer:
      - Supaya bakteria boleh melekat dan memindahkan elektron
      - Supaya lumpur lebih mudah bercampur dengan air
      - Supaya bekas tidak bocor
      - Supaya arus elektrik dapat dihentikan
      answeOnBtn: 0
  - question:
    - Mengapa kita isikan lumpur dalam bekas anod?
    QuestionOnAnswersBtn:
    - answer:
      - Untuk memberi makanan kepada bakteria
      - Untuk menghasilkan elektron melalui bakteria
      - Untuk membenarkan ion bergerak ke katod
      - Untuk menambah berat bekas anod
      answeOnBtn: 1
  - question:
    - Mengapa kita menyambung elektrod anod dan katod menggunakan wayar?
    QuestionOnAnswersBtn:
    - answer:
      - Untuk membolehkan elektron bergerak menghasilkan arus
      - Untuk membolehkan bakteria bergerak ke katod
      - Untuk menambah tenaga ke dalam sistem
      - Untuk memastikan ion bergerak melalui wayar
      answeOnBtn: 0
  - question:
    - Mengapa LED kecil digunakan dalam sistem ini?
    QuestionOnAnswersBtn:
    - answer:
      - Untuk menunjukkan bahawa elektrik dihasilkan
      - Untuk memberi tenaga tambahan kepada bakteria
      - Untuk mengukur jumlah lumpur dalam bekas anod
      - Untuk memastikan ion tidak bergerak terlalu cepat
      answeOnBtn: 0
  - question:
    - Mengapa klip buaya digunakan pada wayar?
    QuestionOnAnswersBtn:
    - answer:
      - Supaya wayar boleh disambungkan dengan kuat ke elektrod
      - Supaya arus boleh berhenti bila-bila masa
      - Supaya ion tidak melalui wayar
      - Supaya bakteria boleh berpindah ke LED
      answeOnBtn: 0
--- !u!114 &1026078786
