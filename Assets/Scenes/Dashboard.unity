  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Reaksi Elektrokimia</b>\n\r\nElektron yang dihasilkan dihantar ke anod
    (elektrod negatif) melalui rantai respirasi bakteria.\r\n\nElektron bergerak
    dari anod ke katod (elektrod positif) melalui rangkaian luar, menghasilkan voltan.\r\n\nPada
    katod, elektron bergabung dengan oksigen dan proton membentuk molekul air (H\u2082O).\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
