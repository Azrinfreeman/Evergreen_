  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Hidrofobik</b> \nGetah mempunyai sifat hidrofobik, yang bermaksud ia
    cenderung menolak air dan lebih cenderung berinteraksi dengan bahan-bahan yang
    tidak larut dalam air (seperti mikroplastik atau bahan organik). Oleh itu, permukaan
    getah akan lebih mudah menarik zarah sisa yang tidak larut, membantu dalam proses
    pemindahan atau penangkapan sisa dari air."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
